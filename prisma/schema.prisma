// SJC Sports Fest cricket. Public pages show team names only. Organiser-only data: player names
// and gender, each team captain's contact details, and individual registrants' phone and email
// (for reaching players). Never store Emirates IDs, parish registration numbers or ages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Stage {
  GROUP
  QF
  SF
  THIRD
  FINAL
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  WALKOVER
  ABANDONED
  DOUBLE_FORFEIT
  POSTPONED
}

model Team {
  id      Int    @id @default(autoincrement())
  name    String @unique
  slug    String @unique
  group   String // "A".."D"
  drawPos Int // position in the group draw, final tie-break

  // From the registration form. Organiser screens only.
  captainName  String?
  captainPhone String?
  captainEmail String?

  matchesAsTeam1 Match[] @relation("team1")
  matchesAsTeam2 Match[] @relation("team2")
  matchesWon     Match[] @relation("winner")
  players        Player[]
}

// A team's roster for the scorer's batter/bowler dropdowns. Grows from names used in scoring.
model Player {
  id        Int      @id @default(autoincrement())
  // Null = an individual registration not yet placed on a team by an organiser.
  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id])
  name      String
  // From the registration form when known; null for players first added at the ground.
  female    Boolean?
  // Individual registrations only (team forms give no per-player contact). Organiser screens only.
  phone     String?
  email     String?
  // Where the player came from: "form" (team registration), "individual" (individual registration),
  // "organiser" (added on the Team contacts page) or "scorer" (+ Add player in the scorer).
  // Form players can't be removed in the app; the others can.
  source    String   @default("form")
  createdAt DateTime @default(now())

  @@unique([teamId, name])
}

model Match {
  id       Int         @id @default(autoincrement())
  matchNo  Int         @unique
  stage    Stage
  group    String?
  startsAt DateTime
  // The published time before the first reschedule or delay, so pages can say "was 5:00 PM".
  // Null when the match is at its original time.
  originalStartsAt DateTime?
  // Knockout teams stay null until known; slot1/slot2 say where they come from ("A1", "W46").
  team1Id  Int?
  team1    Team?       @relation("team1", fields: [team1Id], references: [id])
  team2Id  Int?
  team2    Team?       @relation("team2", fields: [team2Id], references: [id])
  slot1    String?
  slot2    String?
  score1   Int?
  score2   Int?
  status   MatchStatus @default(SCHEDULED)
  // Only set for walkovers and knockout super-overs; otherwise the winner comes from the scores.
  winnerId Int?
  winner   Team?       @relation("winner", fields: [winnerId], references: [id])
  note     String?

  updatedById Int?
  updatedBy   Organiser?      @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime        @updatedAt
  auditLogs   AuditLog[]
  scoring     ScoringSession?
}

model Organiser {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  pinHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Brute-force protection: 5 wrong PINs lock the login for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  matchesUpdated Match[]
  auditLogs      AuditLog[]
  scoring        ScoringSession[]
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  organiserId Int
  organiser   Organiser @relation(fields: [organiserId], references: [id])
  matchId     Int
  match       Match     @relation(fields: [matchId], references: [id])
  action      String
  before      Json
  after       Json
  at          DateTime  @default(now())

  @@index([matchId])
}

model ScoringSession {
  id          Int        @id @default(autoincrement())
  matchId     Int        @unique
  match       Match      @relation(fields: [matchId], references: [id])
  setup       Json
  events      Json
  submitted   Boolean    @default(false)
  updatedById Int?
  updatedBy   Organiser? @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime   @updatedAt
}
